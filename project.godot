; Engine configuration file.
; "Stinky Toss" – 2D Casual Physics-Spiel für Android-Tablets
; Godot 4.x Projektkonfiguration

config_version=5

[application]

config/name="Stinky Toss"
config/description="Wirf Kackhaufen auf Strichmännchen! Ein lustiges Casual-Physik-Spiel."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.53, 0.81, 0.92, 1)

[autoload]

; GameManager als Autoload für Score- und Timer-Status
GameManager="*res://scripts/GameManager.gd"

[display]

; Basis-Auflösung 1920x1200 (16:10) – passt sich per "expand" auch an 4:3 an
window/size/viewport_width=1920
window/size/viewport_height=1200
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input_devices]

; Touch-Eingabe aktivieren. Maus erzeugt Touch-Events (praktisch zum Testen im Editor)
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=1
